# Vault: only the committed templates; the setup jobs generate the rest
vault/**
!vault/**/
!vault/**/*.example
!vault/**/*.gitkeep

static/envs/**
!static/envs/**/
!static/envs/**/*.example

# Generated identity material (the setup jobs write these names)
cert.json.example
public_key.json.example
private_key.json.example

# Extra connectors and authorities: generated config and identities
/instances/

# Private notes, kept out of this public repo
/internal/

# Environment variables
.env
.env.local
.env.*.local
!.env.example
!.env.*.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Go (demo factory, local builds and air)
extensions/demo/service/tmp/
extensions/demo/service/eunomia-demo-factory

# Node
node_modules/

# macOS
.DS_Store

# Notebooks: the Jupyter virtualenv and the executed copies
notebooks/.venv/
notebooks/.runs/
notebooks/sessions/
.ipynb_checkpoints/
# Whatever Jupyter writes into the theme's config dir, apart from the theme
notebooks/jupyter/*
!notebooks/jupyter/custom/
!notebooks/jupyter/labconfig/
!notebooks/jupyter/jupyter_server_config.py
