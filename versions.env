# =====================================================================
# Versiones de las imágenes EUNOMIA: ÚNICO sitio donde se definen.
# Lo leen los compose de deployment/mini y deployment/hack (vía hack.sh /
# hack.ps1, que pasan --env-file versions.env). Cambia aquí y relanza.
#
# Si lanzas un compose a mano, pásale también este fichero:
#   docker compose --env-file versions.env -f deployment/mini/docker-compose.mini.heimdall.yaml up -d
#
# Infraestructura (postgres, redis, ...) NO va aquí: se queda como en main.
# =====================================================================

# Agente / conector (provider y consumer)
EUNOMIA_IMAGE=quay.io/eunomia_upm/ds-agent
EUNOMIA_TAG=v0.4.0

# Autoridad
HEIMDALL_IMAGE=quay.io/eunomia_upm/heimdall
HEIMDALL_TAG=v1.5.0

# Wallet. Ojo: el repo público en Quay es "fafnir-wallet";
# quay.io/eunomia_upm/fafnir pide autenticación (no existe o es privado).
FAFNIR_IMAGE=quay.io/eunomia_upm/fafnir-wallet
FAFNIR_TAG=v0.2.0
