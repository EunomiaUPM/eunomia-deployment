# =====================================================================
# EUNOMIA images: the ONLY place their versions are set.
#
# The eunomia CLI passes this file to every compose file it runs
# (docker compose --env-file versions.env ...). Change a tag here and
# run `eunomia up` again; `eunomia images --check` lists newer tags.
#
# Running a compose file by hand? Pass this file too:
#   docker compose --env-file versions.env \
#     -f deployment/standalone/docker-compose.standalone.heimdall.yaml up -d
#
# Infrastructure images (postgres, redis, keycloak) are pinned in the
# compose files themselves.
# =====================================================================

# Dataspace agent (provider and consumer)
EUNOMIA_IMAGE=quay.io/eunomia_upm/ds-agent
EUNOMIA_TAG=v0.4.0

# Authority
HEIMDALL_IMAGE=quay.io/eunomia_upm/heimdall
HEIMDALL_TAG=v1.5.0

# Wallet. The public Quay repository is "fafnir-wallet";
# quay.io/eunomia_upm/fafnir asks for credentials.
FAFNIR_IMAGE=quay.io/eunomia_upm/fafnir-wallet
FAFNIR_TAG=v0.2.0
