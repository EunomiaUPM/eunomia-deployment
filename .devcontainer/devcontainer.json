{
  // A ready-to-use environment for GitHub Codespaces: Python for the CLI and a
  // Docker engine of its own. Once it opens, run ./eunomia up.
  "name": "EUNOMIA",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "forwardPorts": [1500, 1200, 1100, 1210, 1220, 1230],
  "portsAttributes": {
    "1500": { "label": "Authority" },
    "1200": { "label": "Provider" },
    "1100": { "label": "Consumer" },
    "1210": { "label": "Factory, static API" },
    "1220": { "label": "Factory, dynamic API" },
    "1230": { "label": "Factory Keycloak" }
  },
  "postCreateCommand": "./eunomia doctor"
}
