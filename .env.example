# Copy to .env at the repo root and set only what you need. .env is gitignored.
# Anything already exported in your shell wins over this file.
#
# The standalone deployment needs none of this: every setting has a working
# default. Image versions are not here either: they live in versions.env.

# ── Names and ports (standalone) ─────────────────────────────────────────────
# Prefix of every container and compose project: eunomia-provider, ...
# EUNOMIA_PREFIX=eunomia

# Host ports of the databases (the agent ports 1100, 1200 and 1500 are fixed:
# the participants advertise them to each other).
# EUNOMIA_AUTHORITY_DB_PORT=1450
# EUNOMIA_PROVIDER_DB_PORT=1400
# EUNOMIA_CONSUMER_DB_PORT=1300

# Host ports of the demo factory: static API (pull), dynamic API (push), Keycloak.
# EUNOMIA_FACTORY_STATIC_PORT=1210
# EUNOMIA_FACTORY_DYNAMIC_PORT=1220
# EUNOMIA_FACTORY_KEYCLOAK_PORT=1230

# Port where `eunomia e2e` and `eunomia demo events` receive the pushed events.
# EUNOMIA_SINK_PORT=1290

# Port ranges for `eunomia connector add` and `eunomia authority add`.
# EUNOMIA_HTTP_PORTS=1600-1999
# EUNOMIA_DB_PORTS=15400-15999

# ── Participant URLs (prod) ──────────────────────────────────────────────────
# How the CLI reaches each participant. Prod has no defaults.
AUTHORITY_URL=
PROVIDER_URL=
CONSUMER_URL=

# How the participants reach each other. Default: the URLs above, which is
# right in prod. Standalone uses http://host.docker.internal:<port>.
# DOCKER_AUTHORITY_URL=
# DOCKER_PROVIDER_URL=
# DOCKER_CONSUMER_URL=

# Where the provider agent reaches the demo factory, if it is not on the
# provider's host. Standalone: http://host.docker.internal:<port>.
# DOCKER_FACTORY_STATIC_URL=
# DOCKER_FACTORY_DYNAMIC_URL=
# DOCKER_FACTORY_KEYCLOAK_URL=

# ── eunomia restart: SSH access to the prod servers ─────────────────────────
# Leave *_SSH_PASS empty to use SSH keys; setting it requires sshpass.
# *_PATH is the deployment/prod directory of the checkout on that server.
# *_COMPOSE and *_SERVICE default to the files and services in deployment/prod.

AUTHORITY_SSH_USER=
AUTHORITY_SSH_PASS=
AUTHORITY_SSH_HOST=
AUTHORITY_PATH=
# AUTHORITY_COMPOSE=docker-compose.heimdall.yaml
# AUTHORITY_SERVICE=heimdall

PROVIDER_SSH_USER=
PROVIDER_SSH_PASS=
PROVIDER_SSH_HOST=
PROVIDER_PATH=
# PROVIDER_COMPOSE=docker-compose.provider.yaml
# PROVIDER_SERVICE=provider

CONSUMER_SSH_USER=
CONSUMER_SSH_PASS=
CONSUMER_SSH_HOST=
CONSUMER_PATH=
# CONSUMER_COMPOSE=docker-compose.consumer.yaml
# CONSUMER_SERVICE=consumer
