# Copy to .env at the repo root and set only what you need. .env is gitignored.
# Anything already exported in your shell wins over this file.
#
# Local instances need none of this: every setting has a working
# default. Image versions are not here either: they live in versions.env.

# ── Names and ports ──────────────────────────────────────────────────────────
# Prefix of every local container and compose project: eunomia-<instance>, ...
# EUNOMIA_PREFIX=eunomia

# Port ranges local instances take their HTTP and Postgres ports from.
# EUNOMIA_HTTP_PORTS=1600-1999
# EUNOMIA_DB_PORTS=15400-15999

# Host ports of the demo factory: static API (pull), dynamic API (push), Keycloak.
# EUNOMIA_FACTORY_STATIC_PORT=1210
# EUNOMIA_FACTORY_DYNAMIC_PORT=1220
# EUNOMIA_FACTORY_KEYCLOAK_PORT=1230

# Port where `eunomia e2e` and `eunomia demo events` receive the pushed events.
# EUNOMIA_SINK_PORT=1290

# Where agents reach the demo factory, if it is not on their host.
# Default: http://host.docker.internal:<port>.
# DOCKER_FACTORY_STATIC_URL=
# DOCKER_FACTORY_DYNAMIC_URL=
# DOCKER_FACTORY_KEYCLOAK_URL=

# ── Remote instances (production) ───────────────────────────────────────────
# Remote instances are registered by name, not configured here:
#   eunomia remote add <name> --kind agent --url https://agent.example.org \
#     --ssh deploy@agent.example.org --path /opt/eunomia/deployment/prod
# If a server needs an SSH password, set <NAME>_SSH_PASS (the instance name
# upper-cased, dashes as underscores); leave it unset to use SSH keys.
# FAR_AGENT_SSH_PASS=
